# Security headers for STATIC pages (/, /submit, /admin, and every asset).
#
# Why this file exists: src/middleware.ts only runs for SSR routes. Prerendered
# pages are served straight from the Worker's ASSETS binding and never reach
# Astro middleware, so before this file the HTML pages shipped with no CSP, no
# HSTS and no framing protection — only /api/* was covered. Cloudflare applies
# `_headers` to asset responses, which is the piece that was missing.
#
# KEEP IN SYNC with the header block in src/middleware.ts. The duplication is
# unavoidable (one path is static, served by Cloudflare; the other is dynamic,
# served by Astro) but the two lists should not drift.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.basemaps.cartocdn.com https://server.arcgisonline.com; font-src 'self'; connect-src 'self' https://docs.google.com https://nominatim.openstreetmap.org; frame-src 'self' https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The moderation queue is not secret, but it should not be indexed. Access
# control is the session check in /api/admin/*, not this header.
/admin
  X-Robots-Tag: noindex, nofollow

# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# From https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# The SAME two values your Worker uses for submissions:
#   wrangler secret list   (to confirm they exist on the Worker)
# SHEET_WEBHOOK_URL is the Apps Script ".../exec" URL.
# SHEET_WEBHOOK_TOKEN must equal TOKEN in apps-script/Code.gs.
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
SHEET_WEBHOOK_TOKEN=the-long-random-token

# Safety: when true (the default), the agent reviews and PRINTS verdicts but does
# NOT write to the Sheet. Set to false only once you trust its decisions.
DRY_RUN=true

# Optional
MODEL=claude-sonnet-4-6
MAX_SUBMISSIONS=25
